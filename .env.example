# =============================================================================
# Second Brain — Environment Configuration
# Copy this file to .env and fill in the values.
# =============================================================================

# ── Required ─────────────────────────────────────────────────────────────────
# Absolute path to your Obsidian vault directory.
VAULT_PATH=C:\path\to\obsidian\vault

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Which provider to use for chat: openai | gemini | ollama | anthropic
LLM_PROVIDER=openai

# Optional: override the provider used for embeddings (e.g. when using
# Anthropic for chat, which has no embedding API). Leave empty to use
# the same provider as LLM_PROVIDER.
#   Valid values: openai | gemini | ollama
# EMBEDDING_PROVIDER=

# Common LLM settings
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096

# ── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_BASE_URL=https://api.openai.com/v1

# ── Google Gemini ────────────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-pro
GEMINI_EMBEDDING_MODEL=text-embedding-004

# ── Anthropic ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ── Ollama (local) ───────────────────────────────────────────────────────────
# No API key required — runs locally.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_PATH=./second_brain.db

# PostgreSQL connection string for Next.js/Prisma sync (optional).
# DATABASE_URL=postgresql://user:password@localhost:5432/secondbrain

# ── PostgreSQL Sync ──────────────────────────────────────────────────────────
POSTGRES_SYNC_ENABLED=false
POSTGRES_SYNC_ON_CHANGE=false

# ── API ──────────────────────────────────────────────────────────────────────
API_HOST=127.0.0.1
API_PORT=8000
# API key for authenticated endpoints (leave empty to disable auth).
BRAIN_API_KEY=
# Require API key on all non-public endpoints (recommended for public deployment).
REQUIRE_API_KEY=true
# Enable fail-fast startup security checks intended for public API deployments.
PUBLIC_API_MODE=true
# Public unauthenticated extras (set true only if you explicitly want public docs/config).
EXPOSE_API_DOCS=false
EXPOSE_CONFIG_PUBLIC=false
# Debug controls whether internal exception details are returned in API responses.
DEBUG=false
# Comma-separated CORS origins (use your trusted frontend origins only).
ALLOWED_ORIGINS=https://brain.nikolayvalev.com,http://localhost:3000,http://127.0.0.1:3000
# Comma-separated trusted hostnames for Host header validation.
ALLOWED_HOSTS=brain.nikolayvalev.com,127.0.0.1,localhost
# Keep false unless browser-based credentialed requests are required.
CORS_ALLOW_CREDENTIALS=false

# Rate limiting (enabled by default)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_DEFAULT_PER_WINDOW=120
RATE_LIMIT_ASK_PER_WINDOW=30
RATE_LIMIT_EMBEDDINGS_PER_WINDOW=6
RATE_LIMIT_SYNC_PER_WINDOW=20
RATE_LIMIT_INDEXING_PER_WINDOW=20
# Max accepted request payload size in bytes (1 MiB default).
MAX_REQUEST_BYTES=1048576

# ── Misc ─────────────────────────────────────────────────────────────────────
DEBOUNCE_SECONDS=1.0
LOG_LEVEL=INFO

# ── Reranker (optional, for "rerank" RAG technique) ──────────────────────────
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
